<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="ANTHROPIC_API_KEY" value="test-key-fake-for-http-fake"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Compiled Blade views go somewhere of their own, so a test run and a
             running dev server cannot write the same cache file at the same
             moment. Sharing storage/framework/views made the suite fail
             intermittently in whichever tests happened to render a view while
             `php artisan serve` was recompiling one. -->
        <env name="VIEW_COMPILED_PATH" value="storage/framework/testing/views"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Forced empty so a developer's local .env (set for real subdomain
             testing via "php artisan serve") can never leak into the test
             suite and redirect/404 requests that tests don't expect - tests
             that specifically exercise subdomain behavior set this via
             config() themselves instead. -->
        <env name="TENANT_BASE_DOMAIN" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
