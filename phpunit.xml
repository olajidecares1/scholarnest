<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>

        <!--
            The host the test HTTP client actually uses. Without this the suite
            inherited APP_URL from whatever .env the developer happens to have,
            so a machine set up with lvh.me ran every test against a request to
            localhost while the application generated links to lvh.me, and
            RedirectToCanonicalHost correctly redirected all of them.

            Pinned here so the tests are the same on every machine.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!--
            Passwords are hashed with cheap bcrypt in tests, not with the
            application's real driver.

            config/hashing.php defaults to argon2id at 64MB memory cost, and
            without this line the suite ran that for every hash and every
            verification, thousands of times, each asking the allocator for
            64MB inside one long-lived PHP process.

            When that allocation fails, password_verify() does not raise. It
            returns FALSE, which reaches the user as "These credentials do not
            match our records" for an entirely correct password. That is what
            made a handful of login tests fail only in full-suite runs, on a
            different handful each time, and pass whenever they were run alone.

            BCRYPT_ROUNDS below was already here and had no effect while the
            driver was argon2id.
        -->
        <env name="HASH_DRIVER" value="bcrypt"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Compiled Blade views go somewhere of their own, so a test run and a
             running dev server cannot write the same cache file at the same
             moment. Sharing storage/framework/views made the suite fail
             intermittently in whichever tests happened to render a view while
             `php artisan serve` was recompiling one. -->
        <env name="VIEW_COMPILED_PATH" value="storage/framework/testing/views"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Forced empty so a developer's local .env (set for real subdomain
             testing via "php artisan serve") can never leak into the test
             suite and redirect/404 requests that tests don't expect, tests
             that specifically exercise subdomain behavior set this via
             config() themselves instead. -->
        <env name="TENANT_BASE_DOMAIN" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
