# These are DEVELOPMENT defaults. Three of them are dangerous in production -
# APP_DEBUG, SESSION_SECURE_COOKIE and SESSION_ENCRYPT - and the application
# refuses to serve HTTP requests when APP_ENV=production and any of the three
# is still set for a laptop. docs/PRODUCTION.md has the full list.

APP_NAME=AkademicNest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base domain Standard-plan schools get a free subdomain under (e.g.
# "ednumest.com" -> "greenhill.ednumest.com"). Leave unset locally/staging -
# requires real wildcard DNS + a wildcard TLS certificate in production.
TENANT_BASE_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akademicnest
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Must be true in production: without it the cookie that IS the session is sent
# over plain http. Left unset locally because there is no TLS on a laptop.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OPTIONAL. Document upload and CBT question extraction do NOT use this:
# they run locally (PHPWord for .docx, smalot/pdfparser for .pdf) and work
# with no key, no credit and no internet. This key is used only by the
# payment-receipt screening on the subscription and top-up pages, which fails
# open — a school is never blocked when it is absent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

VITE_APP_NAME="${APP_NAME}"

# Basic-plan portal entry token: the 32 characters in /portal/{token}.
# Generate with "php artisan basic-portal:token". Leave blank and the Basic
# portal returns 404 rather than accepting a predictable default.
BASIC_PORTAL_TOKEN=
