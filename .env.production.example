# ==============================================================================
# AkademicNest — production environment
# ==============================================================================
#
# Copy to .env on the server, fill in every [SET THIS], then:
#
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan production:urls      <- verifies every address below
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# The application REFUSES TO SERVE REQUESTS if APP_DEBUG, the two session
# settings, or APP_URL are wrong in production. That is deliberate: each of them
# fails silently otherwise. Console commands still work, so it can be fixed in
# place. See App\Support\ProductionConfiguration.

APP_NAME=AkademicNest
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ------------------------------------------------------------------------------
# THE PLATFORM ADDRESS
# ------------------------------------------------------------------------------
# Everything is built from this: every link route() generates, every link in an
# email, the host stray traffic is redirected to, and the default target schools
# point their custom domains at.
#
# Must be https, and must be the real domain. An http or local value is refused.
APP_URL=https://akademicanest.com

# ------------------------------------------------------------------------------
# STANDARD PLAN — a subdomain per school
# ------------------------------------------------------------------------------
# greenfield-college.akademicanest.com
#
# REQUIRES INFRASTRUCTURE THIS FILE CANNOT PROVIDE:
#   DNS   *.akademicanest.com   A/AAAA   <this server>
#   TLS   a wildcard certificate for *.akademicanest.com
#
# Without both, every Standard school's website shows a certificate warning.
# Leave this blank until they exist — Standard schools then use /p/{key} paths
# on the main domain, which works, and turning it on later breaks nothing.
TENANT_BASE_DOMAIN=akademicanest.com

# ------------------------------------------------------------------------------
# BASIC PLAN — one shared front door
# ------------------------------------------------------------------------------
# Basic schools have no website and no subdomain. They come in through
# akademicanest.com/{this token}, then type their school name.
#
# Generate with: php artisan basic-portal:token
#
# EMPTY MEANS THE BASIC PORTAL 404s. It fails closed rather than falling back to
# something guessable, so an unset token locks every Basic school out entirely.
BASIC_PORTAL_TOKEN=

# ------------------------------------------------------------------------------
# EXCLUSIVE PLAN — a school's own domain
# ------------------------------------------------------------------------------
# What schools are told to point their DNS at, in the setup wizard.
CUSTOM_DOMAIN_A_RECORD_IP=
CUSTOM_DOMAIN_CNAME_TARGET=akademicanest.com

# The TXT record a school is told to create to prove it owns its domain.
# Prefixes from before the rename are still ACCEPTED during verification (see
# config/custom_domain.php), so a domain verified under an older name keeps
# working without the school touching its DNS again.
CUSTOM_DOMAIN_TXT_PREFIX=_akademicnest-verify

CUSTOM_DOMAIN_AUTO_VERIFY_MINUTES=5

# ------------------------------------------------------------------------------
# SESSION — both of these are refused if wrong
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Without this the cookie that IS the session travels in clear over http.
SESSION_SECURE_COOKIE=true

# Without this session payloads are readable wherever they are stored.
SESSION_ENCRYPT=true

SESSION_PATH=/

# Leave null unless sessions must be shared with subdomains. Setting it to
# ".akademicanest.com" would send the platform's session cookie to every
# school's subdomain as well, which is the opposite of what tenant isolation is
# for.
SESSION_DOMAIN=null

SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akademicnest
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# QUEUE — a worker must be running
# ------------------------------------------------------------------------------
# CBT document extraction is queued. With no worker, an upload sits at
# "Waiting to start" for ever and the school reports it as broken.
#
#   deploy/supervisor/akademicnest-worker.conf
#
# ON LARAVEL CLOUD there is no supervisor. Add a Worker cluster to the
# environment instead - that is the thing that runs the queue - and do not add
# `php artisan queue:restart` to the deploy commands, because Cloud restarts
# workers itself after every deployment.
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# MAIL
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=support@akademicanest.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# PAYMENT RECEIPT SCREENING
# ------------------------------------------------------------------------------
# Uploaded receipts are sent to Anthropic's API to be checked before a person
# reviews them. This is a CROSS-BORDER TRANSFER OF PERSONAL DATA — receipts
# carry payer names and bank details — and is disclosed in the Privacy Policy.
#
# Leave blank to turn screening off entirely. Uploads then go straight to manual
# review with a note that the automatic check did not run; nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------------------------------
# UPLOADED FILES
# ------------------------------------------------------------------------------
# The application writes to two disks by name. "public" is what a browser is
# meant to see - logos, favicons, ID card photographs. "local" is what it must
# never see - payment receipts carrying payer names and bank details, CBT source
# documents, passport photographs.
#
# ON A SINGLE SERVER, leave all of this alone. Both disks are directories under
# storage/, and `php artisan storage:link` makes the public one reachable.
#
# ON AN EPHEMERAL FILESYSTEM - Laravel Cloud, where the disk is reset by every
# deployment and each replica has its own copy - directories under storage/ mean
# every upload is gone at the next deploy. Both disks must be object storage:
#
#   1. Create TWO buckets. R2 sets visibility per bucket, not per file, so one
#      bucket cannot hold both. A private receipt in a public bucket is a data
#      breach, which is why this is two buckets and not one.
#        - a PUBLIC bucket   -> the variables below
#        - a PRIVATE bucket  -> the variables below
#   2. Copy each bucket's credentials from its "View credentials" panel.
#   3. PUBLIC_AWS_URL is on the bucket's settings page. It is NOT injected
#      automatically - without it every image on the site renders broken.
#   4. Do NOT run `php artisan storage:link`. There is nothing to link to, and
#      the link would not survive the deploy anyway.

# Leave as "local" for a normal server; set to "s3" for object storage.
PUBLIC_FILESYSTEM_DRIVER=local
PUBLIC_AWS_ACCESS_KEY_ID=
PUBLIC_AWS_SECRET_ACCESS_KEY=
PUBLIC_AWS_BUCKET=
PUBLIC_AWS_ENDPOINT=
PUBLIC_AWS_URL=
PUBLIC_AWS_DEFAULT_REGION=auto

PRIVATE_FILESYSTEM_DRIVER=local
PRIVATE_AWS_ACCESS_KEY_ID=
PRIVATE_AWS_SECRET_ACCESS_KEY=
PRIVATE_AWS_BUCKET=
PRIVATE_AWS_ENDPOINT=
PRIVATE_AWS_DEFAULT_REGION=auto

# The default disk for Storage:: calls that name no disk. "local" here means
# the private disk above, whichever backend it resolves to.
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
